# Copy to .env and fill in. .env is git-ignored.

# --- Option 1: Claude (paid API) ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# --- Option 2: free open-source model via an OpenAI-compatible server ---
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1   # Ollama (default); LM Studio: http://localhost:1234/v1
# OPENAI_COMPAT_MODEL=llama3.1:8b
# OPENAI_COMPAT_API_KEY=                             # only for hosted APIs (Groq, OpenRouter, ...)

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# RESEARCH_DOMAIN=Agentic AI
# LOOKBACK_DAYS=14
# TOP_N=10
# BRIEF_FOCUS=how to architect a multi-agent system
# MIN_QUALITY_SCORE=6.0
# EVAL_WORKERS=4
# EMBEDDER=auto            # auto | hashing | st:all-MiniLM-L6-v2
# USE_REFUSAL_FALLBACK=1
